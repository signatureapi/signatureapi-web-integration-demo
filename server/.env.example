# Copy to .env and fill in. Never commit .env.
# Test-mode key from https://dashboard.signatureapi.com/settings/api-keys
# The server refuses to start with a live key.
SIGNATUREAPI_KEY=key_test_...

# Port the demo server listens on.
PORT=3000

# Origin the page is opened from; the ceremony may be framed only from here.
# Defaults to http://localhost:<PORT>. Set it when the demo runs behind another host name.
# APP_ORIGIN=https://demo.example.com
